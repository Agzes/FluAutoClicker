{
  "name": "fluautoclicker",
  "private": true,
  "version": "0.1.0-beta.8",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native",
    "typecheck": "tsc --noEmit",
    "smoke:static": "node scripts/smoke-static.mjs",
    "smoke:i18n": "node scripts/smoke-i18n.mjs",
    "lint": "pnpm run typecheck && pnpm run lint:js && pnpm run lint:css && pnpm run smoke:static && pnpm run smoke:i18n && pnpm run version:check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "budget": "node scripts/check-bundle-budget.mjs",
    "build": "tsc && vite build --config vite.config.mjs --configLoader native",
    "preview": "vite preview --config vite.config.mjs --configLoader native",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3"
  }
}

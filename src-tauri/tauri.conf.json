{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluAutoClicker",
  "version": "0.1.0-beta.8",
  "identifier": "io.github.agzes.fluautoclicker",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FluAutoClicker",
        "width": 480,
        "height": 570,
        "minWidth": 480,
        "minHeight": 570,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "FluAutoClicker CLI",
      "args": [
        {
          "name": "toggle",
          "short": "t",
          "description": "Toggle clicker running state",
          "takesValue": false
        },
        {
          "name": "start",
          "short": "s",
          "description": "Start clicker",
          "takesValue": false
        },
        {
          "name": "stop",
          "short": "x",
          "description": "Stop clicker",
          "takesValue": false
        },
        {
          "name": "exit",
          "short": "e",
          "description": "Close application",
          "takesValue": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
